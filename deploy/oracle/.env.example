# Copiază în .env pe server și setează valori generate local, fără să le comiți.
APP_PUBLIC_URL=https://finante.example.net
APP_PASSWORD_HASH=
APP_PASSWORD_SALT=
# Pentru backup criptat, cheia se păstrează separat de server/repository.
BACKUP_ENCRYPTION_KEY=

# WhatsApp rămâne complet dezactivat implicit. Completează doar după Meta setup.
WHATSAPP_ENABLE_MESSAGING=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# ID-urile expeditorilor WhatsApp autorizate, numere fără semnul +, separate prin virgulă.
WHATSAPP_ALLOWED_SENDERS=
# Raportul PDF se poate trimite numai ca răspuns la cererea explicită din WhatsApp.
WHATSAPP_ALLOW_REPORTS=false
